
div(class=""+portfolio_width)
	.col-lg-12
		ul(class="alx-portfolio-control alx-portfolio__nav "+portfolio_navigation)
			li(data-filter="*").alx-active= t.portfolio.filters.all
				
			li(data-filter=".alx-f-branding")= t.portfolio.filters.branding
	
			li(data-filter=".alx-f-web")= t.portfolio.filters.web
				
			li(data-filter=".alx-f-graphic")= t.portfolio.filters.graphic
				
			li(data-filter=".alx-f-logo")= t.portfolio.filters.logo

			li(data-filter=".alx-f-photography")= t.portfolio.filters.photography
					

	div(class="alx-portfolio-items alx-layout-isotope " + portfolio_wrap, data-grid=''+ portfolio_grid)
		//- Start item
		.alx-isotope-item.alx-f-branding.alx-f-photography
			div(class="alx-portfolio-item " + portfolio_style)
				if portfolio_link
					a(href="portfolio-single.html")
				else
					a.alx-img-gallery(href="images/portfolio/1.jpg")
				.alx-portfolio-item-image
					div.alx-bg-img(data-image="images/portfolio/1.jpg")
				.alx-portfolio-item-details
					h4= t.portfolio.items["1"]
					p= t.portfolio.category
