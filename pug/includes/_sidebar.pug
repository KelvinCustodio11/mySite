aside.alx-aside-sidebar.alx-aside-sidebar__dark.alx-bg-img#alx-sidebar(data-image="images/sidebar.jpg")
	.alx-lang-change
		ul
			li
				a.active(href=t.switcher.selfHref data-alx-lang-self title=t.switcher.activeFull)= t.switcher.active
			li
				a(href=t.switcher.otherHref data-alx-lang-link title=t.switcher.otherFull)= t.switcher.other
	a.alx-burger.alx-burger__open(href="#")
		span
	.alx-sidebar-widget
		h5= t.sidebar.hello
		img.img-responsive(src="images/person.jpg", alt="")
		p= t.sidebar.text
	hr
	

	.alx-sidebar-menu
		ul
			include ../html/_menu.pug

	include ../includes/_social-links.pug

	.alx-copyright= t.sidebar.copyright
		br 
		= t.sidebar.by
		a(href="https://themeforest.net/user/alian4x" target="blank") 
			strong  Alian4x
		
.alx-aside-sidebar__overlay
