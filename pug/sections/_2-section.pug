
section.alx-vertical-middle.alx-white-section.pp-scrollable(data-scene='layers')
	
	.container
		.row.align-items-center
			.col-lg-5.alx-style(data-style="margin: 50px 0")
				.alx-heading
					.alx-heading__pretitle
						i.fa.fa-diamond
						= t.services.pretitle
					h2.alx-heading__title= t.services.title
					.alx-heading__zigzag
						svg(x='0px', y='0px', viewBox='0 0 100 19.5')
							g
								polygon(points='79.3,18 69.6,8.3 60,18 50.3,8.3 40.6,18 31,8.3 21.3,18 11.7,8.3 3.4,16.5 0.6,13.7 11.7,2.7 21.3,12.3 31,2.7 \
								40.6,12.3 50.3,2.7 60,12.3 69.6,2.7 79.3,12.3 88.9,2.7 100,13.6 97.2,16.4 89,8.3 ')
					.alx-heading__description= t.services.description
				a.alx-btn(href="#page9")= t.services.cta
			.col-lg-6.offset-lg-1
				.alx-services.alx-dots-style(data-interval="7000")
					.alx-services__container
						.alx-services__item
							.alx-services__item__wrap
								.alx-services__item__main
									i.fa.fa-server
									h4.alx-services__item__title= t.services.items.video.title

								.alx-services__item__description= t.services.items.video.text
								.alx-services__item__opacityicon
									i.fa.fa-server
						.alx-services__item
							.alx-services__item__wrap
								.alx-services__item__main
									i.fa.fa-desktop
									h4.alx-services__item__title= t.services.items.photo.title
								.alx-services__item__description= t.services.items.photo.text
								.alx-services__item__opacityicon
									i.fa.fa-desktop
						.alx-services__item
							.alx-services__item__wrap
								.alx-services__item__main
									i.fa.fa-plug
									h4.alx-services__item__title= t.services.items.designer.title
								.alx-services__item__description= t.services.items.designer.text
								.alx-services__item__opacityicon
									i.fa.fa-plug
						.alx-services__item
							.alx-services__item__wrap
								.alx-services__item__main
									i.fa.fa-database
									h4.alx-services__item__title= t.services.items.manager.title
								.alx-services__item__description= t.services.items.manager.text
								.alx-services__item__opacityicon
									i.fa.fa-database
					.alx-services__container
						.alx-services__item
							.alx-services__item__wrap
								.alx-services__item__main
									i.fa.fa-check-circle-o
									h4.alx-services__item__title= t.services.items.wordpress.title

								.alx-services__item__description= t.services.items.wordpress.text
								.alx-services__item__opacityicon
									i.fa.fa-check-circle-o
						.alx-services__item
							.alx-services__item__wrap
								.alx-services__item__main
									i.fa.fa-cubes
									h4.alx-services__item__title= t.services.items.css.title
								.alx-services__item__description= t.services.items.css.text
								.alx-services__item__opacityicon
									i.fa.fa-cubes
						.alx-services__item
							.alx-services__item__wrap
								.alx-services__item__main
									i.fa.fa-sitemap
									h4.alx-services__item__title= t.services.items.opencart.title
								.alx-services__item__description= t.services.items.opencart.text
								.alx-services__item__opacityicon
									i.fa.fa-sitemap
						.alx-services__item
							.alx-services__item__wrap
								.alx-services__item__main
									i.fa.fa-life-ring
									h4.alx-services__item__title= t.services.items.support.title
								.alx-services__item__description= t.services.items.support.text
								.alx-services__item__opacityicon
									i.fa.fa-life-ring
					
						
	canvas.alx-scene(data-scene='layers' aria-hidden='true')
