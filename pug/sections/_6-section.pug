section.alx-vertical-middle.alx-white-section.pp-scrollable(data-scene='wire')
	.alx-vertical-heading
		i.fa.fa-rocket
		= t.portfolio.vertical

	//--START Portfolio Default
	- var portfolio_style = 'alx-portfolio-item__style1';
	- var portfolio_grid = '4';
	- var portfolio_width = 'container';
	- var portfolio_navigation = 'alx-text-left';
	- var portfolio_wrap = 'alx-isotope-gap';
	- var portfolio_link = false;

	include ../portfolio/_portfolio-default.pug
	//--END Portfolio Default
	canvas.alx-scene(data-scene='wire' aria-hidden='true')
