
section.alx-vertical-middle.alx-white-section.pp-scrollable.alx-bg-img(data-image="images/bg4.jpg")
	.alx-vertical-heading
		i.fa.fa-heart-o
		= t.clients.vertical
	.container
		.row.align-items-center
			.col-lg-5.alx-style(data-style="margin: 50px 0")
				.alx-heading
					h2.alx-heading__title= t.clients.title
					.alx-heading__zigzag
						svg(x='0px', y='0px', viewBox='0 0 100 19.5')
							g
								polygon(points='79.3,18 69.6,8.3 60,18 50.3,8.3 40.6,18 31,8.3 21.3,18 11.7,8.3 3.4,16.5 0.6,13.7 11.7,2.7 21.3,12.3 31,2.7 \
								40.6,12.3 50.3,2.7 60,12.3 69.6,2.7 79.3,12.3 88.9,2.7 100,13.6 97.2,16.4 89,8.3 ')
					.alx-heading__description= t.clients.description
				a.alx-btn(href="#")= t.clients.cta
			.col-lg-6.offset-lg-1
				.alx-services.alx-services__partners.alx-dots-style(data-interval="7000")
					.alx-services__container
						.alx-services__item
