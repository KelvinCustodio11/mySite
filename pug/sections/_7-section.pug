
section.alx-vertical-middle.alx-white-section.pp-scrollable(data-scene='signal')
	.alx-vertical-heading
		i.fa.fa-bell-o
		= t.contact.vertical
	.container
		.row.align-items-center
			.col-lg-5
				.alx-heading
					h2.alx-heading__title= t.contact.title
					.alx-heading__zigzag
						svg(x='0px', y='0px', viewBox='0 0 100 19.5')
							g
								polygon(points='79.3,18 69.6,8.3 60,18 50.3,8.3 40.6,18 31,8.3 21.3,18 11.7,8.3 3.4,16.5 0.6,13.7 11.7,2.7 21.3,12.3 31,2.7 \
								40.6,12.3 50.3,2.7 60,12.3 69.6,2.7 79.3,12.3 88.9,2.7 100,13.6 97.2,16.4 89,8.3 ')

		.row
			.col-lg-4
				.alx-icon
					.alx-icon__icon
						span
							i.fa.fa-whatsapp
					.alx-icon__text
						h5= t.contact.phone
						a(href=t.social.whatsapp target="_blank" rel="noopener")= t.contact.phoneValue
				.alx-icon
					.alx-icon__icon
						span
							i.fa.fa-envelope
					.alx-icon__text
						h5= t.contact.email
						a(href="mailto:" + t.contact.emailValue)= t.contact.emailValue
						br
						a(href="mailto:" + t.contact.emailValue2)= t.contact.emailValue2
				.alx-icon
					.alx-icon__icon
						span
							i.fa.fa-home
					.alx-icon__text
						h5= t.contact.address
						p= t.contact.addressValue
			.col-lg-8
				
				form.alx-contact-form(action="#")
					.row
						.col-lg-6
							.alx-input-group
								input(name="name" type="text" required placeholder=t.contact.form.name)
								i.fa.fa-user-o
						.col-lg-6
							.alx-input-group
								input(name="email" type="email" required placeholder=t.contact.form.email)
								i.fa.fa-at
						.col-lg-12
							.alx-input-group
								textarea(name="message" rows="6" required placeholder=t.contact.form.message)
								i.fa.fa-commenting-o
							.alx-success-msg.hide
								p= t.contact.form.success

							input(type="submit" class="alx-btn" value=t.contact.form.submit)

					
					
			
				

	canvas.alx-scene(data-scene='signal' aria-hidden='true')
