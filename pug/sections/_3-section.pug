section.alx-vertical-middle.alx-white-section.pp-scrollable.alx-bg-img(data-image="images/bg3.jpg")
	.alx-vertical-heading
		i.fa.fa-code
		= t.skills.vertical
	.container
		.row.justify-content-center
			.col-lg-5.alx-style(data-style="margin: 50px 0")
				.alx-heading
					h2.alx-heading__title= t.skills.title
					.alx-heading__zigzag
						svg(x='0px', y='0px', viewBox='0 0 100 19.5')
							g
								polygon(points='79.3,18 69.6,8.3 60,18 50.3,8.3 40.6,18 31,8.3 21.3,18 11.7,8.3 3.4,16.5 0.6,13.7 11.7,2.7 21.3,12.3 31,2.7 \
								40.6,12.3 50.3,2.7 60,12.3 69.6,2.7 79.3,12.3 88.9,2.7 100,13.6 97.2,16.4 89,8.3 ')
					.alx-heading__description= t.skills.description
						br
						strong= t.skills.strong
				.alx-skills-list
					ul
						li
							span 01
							= t.skills.list[0]
						li
							span 02
							= t.skills.list[1]
						li
							span 03
							= t.skills.list[2]
						li
							span 04
							= t.skills.list[3]
						li
							span 05
							= t.skills.list[4]
			.col-lg-5.offset-lg-2.align-self-center
				.alx-skills
					.alx-skills__header
						.alx-skills__title= t.skills.bars.branding
						.alx-skills__count 80%
					.alx-skills__body
						.alx-skills__bar(data-skills="80%")
				.alx-skills
					.alx-skills__header
						.alx-skills__title= t.skills.bars.coding
						.alx-skills__count 90%
					.alx-skills__body
						.alx-skills__bar(data-skills="90%")
				.alx-skills
					.alx-skills__header
						.alx-skills__title= t.skills.bars.wordpress
						.alx-skills__count 70%
					.alx-skills__body
						.alx-skills__bar(data-skills="70%")
				.alx-skills
					.alx-skills__header
						.alx-skills__title= t.skills.bars.html
						.alx-skills__count 60%
					.alx-skills__body
						.alx-skills__bar(data-skills="60%")
			
