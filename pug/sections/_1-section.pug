section.alx-hero.alx-vertical-middle.alx-white-section.pp-scrollable(data-scene='ide')
	.container
		.row.justify-content-center
			.col-lg-8
				.alx-heading.alx-text-center
					.alx-heading__pretitle
						i.fa.fa-hand-peace-o
						span.alx-pretype= t.hero.pretitle
					//- O título real fica no .sr-only (leitor de tela/JS desligado);
					//- o texto animado é aria-hidden e é digitado pelo js/typewriter.js
					h1.alx-heading__title.alx-typed(data-phrases=JSON.stringify(t.hero.phrases))
						span.sr-only= t.hero.title
						span.alx-typed__prompt(aria-hidden='true')= '>'
						span.alx-typed__body(aria-hidden='true')= t.hero.phrases[0]
					.alx-heading__zigzag
						svg(x='0px', y='0px', viewBox='0 0 100 19.5')
							g
								polygon(points='79.3,18 69.6,8.3 60,18 50.3,8.3 40.6,18 31,8.3 21.3,18 11.7,8.3 3.4,16.5 0.6,13.7 11.7,2.7 21.3,12.3 31,2.7 \
								40.6,12.3 50.3,2.7 60,12.3 69.6,2.7 79.3,12.3 88.9,2.7 100,13.6 97.2,16.4 89,8.3 ')

				.alx-btns-section.alx-text-center
					a.alx-btn(href="#page9")= t.hero.cta1
					a.alx-btn.alx-btn-primary(href="#page6")= t.hero.cta2
			.col-lg-6.offset-lg-1
	#alx-particles.alx-canvas
	canvas.alx-scene(data-scene='ide' aria-hidden='true')
