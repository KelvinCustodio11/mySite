
section.alx-vertical-middle.alx-white-section.pp-scrollable(data-scene='path')
	.alx-vertical-heading
		i.fa.fa-question-circle-o
		= t.about.vertical
	.container
		.row.align-items-center
			.col-lg-6.order-lg-12
				.alx-person-image.alx-dots-style
					img.img-responsive.alx-tilt(src="images/person.jpg", alt="")
					h3.alx-person-image__title.alx-text-center= t.about.experience
			.col-lg-6.alx-style(data-style="margin: 50px 0")
				.alx-heading
					h2.alx-heading__title= t.about.title
					.alx-heading__zigzag
						svg(x='0px', y='0px', viewBox='0 0 100 19.5')
							g
								polygon(points='79.3,18 69.6,8.3 60,18 50.3,8.3 40.6,18 31,8.3 21.3,18 11.7,8.3 3.4,16.5 0.6,13.7 11.7,2.7 21.3,12.3 31,2.7 \
								40.6,12.3 50.3,2.7 60,12.3 69.6,2.7 79.3,12.3 88.9,2.7 100,13.6 97.2,16.4 89,8.3 ')
					.alx-heading__description= t.about.description
					.alx-heading__pretitle.alx-style(data-style="margin-top: 20px")
						i.fa.fa-diamond
						= t.about.pretitle
				a.alx-btn(href="#page9")= t.about.cta
			
				
	canvas.alx-scene(data-scene='path' aria-hidden='true')
