section.alx-vertical-middle.alx-white-section.pp-scrollable.alx-bg-img(data-image="images/bg10.jpg")
	.alx-vertical-heading
		i.fa.fa-commenting-o
		= t.testimonials.vertical
	.container
		.row
			.col-lg-12
				.alx-heading
					h2.alx-heading__title= t.testimonials.title
					.alx-heading__zigzag
						svg(x='0px', y='0px', viewBox='0 0 100 19.5')
							g
								polygon(points='79.3,18 69.6,8.3 60,18 50.3,8.3 40.6,18 31,8.3 21.3,18 11.7,8.3 3.4,16.5 0.6,13.7 11.7,2.7 21.3,12.3 31,2.7 \
								40.6,12.3 50.3,2.7 60,12.3 69.6,2.7 79.3,12.3 88.9,2.7 100,13.6 97.2,16.4 89,8.3 ')
			.alx-testimonials
				.alx-testimonials__slides
					.alx-testimonials__item
						img(src="images/review1.jpg", alt="")
						.alx-testimonials__content
							
							.alx-testimonials__item__review
								i.fa.fa-star
								i.fa.fa-star
								i.fa.fa-star
								i.fa.fa-star
								i.fa.fa-star-half-o
							.alx-testimonials__item__name= t.testimonials.items[0].name
							.alx-testimonials__item__text= t.testimonials.items[0].text
					.alx-testimonials__item
						img(src="images/review2.jpg", alt="")
						.alx-testimonials__content
							
							.alx-testimonials__item__review
								i.fa.fa-star
								i.fa.fa-star
								i.fa.fa-star
								i.fa.fa-star
								i.fa.fa-star
							.alx-testimonials__item__name= t.testimonials.items[1].name
							.alx-testimonials__item__text= t.testimonials.items[1].text
					.alx-testimonials__item
						img(src="images/review3.jpg", alt="")
						.alx-testimonials__content
							
							.alx-testimonials__item__review
								i.fa.fa-star
								i.fa.fa-star
								i.fa.fa-star
								i.fa.fa-star
								i.fa.fa-star-half-o
							.alx-testimonials__item__name= t.testimonials.items[2].name
							.alx-testimonials__item__text= t.testimonials.items[2].text
					
			
				.alx-slider__nav
					.alx-slider__nav__prev
						.alx-slider__nav__next__icon
							i.fa.fa-angle-double-left
					.alx-slider__nav__dots
					.alx-slider__nav__next
						.alx-slider__nav__next__icon
							i.fa.fa-angle-double-right
				
